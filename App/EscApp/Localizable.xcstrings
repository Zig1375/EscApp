    "Installed": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установлено"
          }
        }
      }
    },
    "Installing %@…": {
      "localizations": {
        "ru": {
          "stringUnit": {
