            "value": "No se ha podido añadir D3DMetal: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ajouter D3DMetal : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aggiungere D3DMetal: %@"
          }
        },
        "ja": {
          "stringUnit": {
