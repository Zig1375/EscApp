          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы игры %@ не найдены"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 %@ 的文件"
          }
        }
      }
    },
    "Magic Kettle can't find %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle findet %@ nicht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle no encuentra %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle ne trouve pas %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle non trova %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettleは%@を見つけられません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle에서 %@ 파일을 찾을 수 없습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle не может найти %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle 找不到 %@"
          }
        }
      }
    },
    "Magic Kettle can't find %@. If you moved the game's folder, open the game from its new place. If you deleted it, put it back, or delete the game from Magic Kettle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle findet %@ nicht. Wenn du den Ordner des Spiels verschoben hast, öffne das Spiel an seinem neuen Ort. Wenn du ihn gelöscht hast, lege ihn zurück oder lösche das Spiel aus Magic Kettle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle no encuentra %@. Si moviste la carpeta del juego, ábrelo desde su nueva ubicación. Si la eliminaste, vuelve a ponerla o elimina el juego de Magic Kettle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle ne trouve pas %@. Si vous avez déplacé le dossier du jeu, ouvrez le jeu depuis son nouvel emplacement. Si vous l’avez supprimé, remettez-le en place ou supprimez le jeu de Magic Kettle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle non trova %@. Se hai spostato la cartella del gioco, apri il gioco dalla nuova posizione. Se l’hai eliminata, rimettila al suo posto o elimina il gioco da Magic Kettle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettleは%@を見つけられません。ゲームのフォルダを移動した場合は、新しい場所からゲームを開いてください。削除した場合は元に戻すか、Magic Kettleからゲームを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle에서 %@ 파일을 찾을 수 없습니다. 게임 폴더를 옮겼다면 새 위치에서 게임을 여세요. 삭제했다면 다시 넣거나 Magic Kettle에서 게임을 삭제하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle не может найти %@. Если вы переместили папку игры, откройте игру с нового места. Если удалили — верните её или удалите игру из Magic Kettle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle 找不到 %@。如果你移动了游戏文件夹，请从新位置打开游戏。如果你删除了它，请将其放回，或从 Magic Kettle 中删除该游戏。"
          }
        }
      }
    },
    "Magic Kettle can't find this game's files. If you moved its folder, open the game from its new place. If you deleted it, put it back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle findet die Dateien dieses Spiels nicht. Wenn du seinen Ordner verschoben hast, öffne das Spiel an seinem neuen Ort. Wenn du ihn gelöscht hast, lege ihn zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle no encuentra los archivos de este juego. Si moviste su carpeta, abre el juego desde su nueva ubicación. Si la eliminaste, vuelve a ponerla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle ne trouve pas les fichiers de ce jeu. Si vous avez déplacé son dossier, ouvrez le jeu depuis son nouvel emplacement. Si vous l’avez supprimé, remettez-le en place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle non trova i file di questo gioco. Se hai spostato la sua cartella, apri il gioco dalla nuova posizione. Se l’hai eliminata, rimettila al suo posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettleはこのゲームのファイルを見つけられません。フォルダを移動した場合は、新しい場所からゲームを開いてください。削除した場合は元に戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle에서 이 게임의 파일을 찾을 수 없습니다. 폴더를 옮겼다면 새 위치에서 게임을 여세요. 삭제했다면 다시 넣으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle не может найти файлы этой игры. Если вы переместили её папку, откройте игру с нового места. Если удалили — верните её."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle 找不到此游戏的文件。如果你移动了它的文件夹，请从新位置打开游戏。如果你删除了它，请将其放回。"
          }
        }
      }
    },
