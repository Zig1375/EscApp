        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установить Steam"
          }
        }
      }
    },
    "Installing · %@ of %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливается · %1$@ из %2$@"
          }
        }
      }
