    "Magic Kettle runs Windows games on this Mac. Just open a game, and it takes care of the rest.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle führt Windows-Spiele auf diesem Mac aus. Öffne einfach ein Spiel – um den Rest kümmert sich Magic Kettle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle ejecuta juegos de Windows en este Mac. Solo tienes que abrir un juego y se encarga del resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle exécute les jeux Windows sur ce Mac. Ouvrez simplement un jeu, et Magic Kettle s’occupe du reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle esegue i giochi Windows su questo Mac. Apri un gioco e al resto pensa lui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic KettleはこのMacでWindowsゲームを実行します。ゲームを開くだけで、あとはすべておまかせです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle은 이 Mac에서 Windows 게임을 실행합니다. 게임을 열기만 하면 나머지는 알아서 처리합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle запускает Windows-игры на этом Mac. Просто откройте игру, остальное он сделает сам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Kettle 可在这台 Mac 上运行 Windows 游戏。只需打开游戏，其余的交给它。"
          }
        }
      }
    },
