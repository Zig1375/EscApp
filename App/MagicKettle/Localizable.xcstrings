    "This Mac needs a newer version of Magic Kettle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac braucht eine neuere Version von Magic Kettle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac necesita una versión más reciente de Magic Kettle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac nécessite une version plus récente de Magic Kettle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac richiede una versione più recente di Magic Kettle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacには新しいバージョンのMagic Kettleが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
