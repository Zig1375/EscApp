    "Each store lives in its own Windows and doesn't affect other games.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Store läuft in seinem eigenen Windows und beeinflusst andere Spiele nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada tienda funciona en su propio Windows y no afecta a otros juegos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque boutique dispose de son propre Windows et n’affecte pas les autres jeux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni negozio ha il suo Windows e non influisce sugli altri giochi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ストアは専用のWindowsで動作し、ほかのゲームには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 스토어는 자체 Windows에서 실행되며 다른 게임에 영향을 주지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый магазин живёт в своей среде Windows и не влияет на другие игры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个商店都运行在自己的 Windows 中，不会影响其他游戏。"
          }
        }
      }
    },
