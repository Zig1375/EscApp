    "If you pick one yourself, retrying after a failure is turned off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du selbst eine Option wählst, wird nach einem Fehler nicht erneut versucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si eliges uno tú, se desactiva el reintento tras un fallo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous en choisissez un vous-même, les nouvelles tentatives après un échec sont désactivées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ne scegli una tu, il nuovo tentativo dopo un errore viene disattivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で選択すると、失敗時の再試行はオフになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 선택하면 실패 후 재시도가 꺼집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выбрать вручную, автоповтор при сбое отключится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你自行选择，失败后将不再自动重试。"
          }
        }
      }
    },
