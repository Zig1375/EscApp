    "Settings can be changed once the game is closed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen können geändert werden, sobald das Spiel beendet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes se pueden cambiar cuando el juego esté cerrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages peuvent être modifiés une fois le jeu fermé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni si possono cambiare quando il gioco è chiuso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定はゲームを終了すると変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임을 닫은 후에 설정을 변경할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки можно менять, когда игра закрыта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭游戏后即可更改设置。"
          }
        }
      }
    },
