            "state": "translated",
            "value": "Los juegos DirectX 12 ya arrancan como cualquier otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jeux DirectX 12 démarrent désormais comme les autres."
          }
