    "The game folder%@ goes to the Trash. Until the Trash is emptied, the game can be restored.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка игры%@ уйдёт в Корзину. Пока Корзина не очищена, игру можно восстановить."
          }
        }
      }
    },
    "The game hasn't been started yet.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игру ещё не запускали."
          }
        }
      }
    },
    "The game stays in %@. ExePort forgets it and deletes its Windows setup. Double-click the exe to bring it back.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игра останется в %@. ExePort забудет её и удалит её среду Windows. Вернуть можно двойным щелчком по exe."
          }
        }
      }
    },
    "This game is no longer in ExePort.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этой игры больше нет в ExePort."
          }
        }
      }
    },
    "To add a game, double-click its .exe or .msi in Finder, or drag the file onto the ExePort icon in the Dock.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы добавить игру, дважды щёлкните по .exe или .msi в Finder или перетащите файл на значок ExePort в Dock."
          }
        }
      }
    },
