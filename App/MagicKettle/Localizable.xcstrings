        }
      }
    },
    "The game's file uses d3d12.dll": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spieldatei nutzt d3d12.dll"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo del juego usa d3d12.dll"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier du jeu utilise d3d12.dll"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file del gioco usa d3d12.dll"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームのファイルが d3d12.dll を使用しています"
          }
        },
        "ko": {
