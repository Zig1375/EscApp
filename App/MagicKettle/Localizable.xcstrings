    "Real size on disk. Finder shows about %@: most of it is shared with other games.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatsächliche Größe auf dem Laufwerk. Der Finder zeigt etwa %@ an: Das meiste davon wird mit anderen Spielen geteilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño real en disco. El Finder muestra unos %@: la mayor parte se comparte con otros juegos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille réelle sur le disque. Le Finder affiche environ %@ : la majeure partie est partagée avec d’autres jeux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensione reale su disco. Il Finder mostra circa %@: gran parte è condivisa con altri giochi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク上の実際のサイズです。Finderでは約%@と表示されますが、その大部分はほかのゲームと共有されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 디스크 사용량입니다. Finder에는 약 %@(으)로 표시되지만, 대부분은 다른 게임과 공유됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реальный размер на диске. Finder покажет около %@: большая часть общая с другими играми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实际占用的磁盘空间。访达显示约为 %@：其中大部分与其他游戏共用。"
          }
        }
      }
    },
