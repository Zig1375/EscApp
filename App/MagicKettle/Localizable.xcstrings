            "value": "游戏文件使用了 d3d12.dll"
          }
        }
      }
    },
    "This file can't be opened. It may be damaged or still downloading.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei lässt sich nicht öffnen. Sie ist vielleicht beschädigt oder wird noch geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede abrir este archivo. Puede que esté dañado o que aún se esté descargando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir ce fichier. Il est peut-être endommagé ou encore en cours de téléchargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire questo file. Potrebbe essere danneggiato o ancora in download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルを開けません。破損しているか、まだダウンロード中の可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일을 열 수 없습니다. 손상되었거나 아직 다운로드 중일 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл не открывается. Возможно, он повреждён или ещё скачивается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开此文件。它可能已损坏或仍在下载中。"
          }
        }
      }
    },
    "This file doesn't contain D3DMetal. Download “Evaluation environment for Windows games” from Apple's page, not “Game Porting Toolkit”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei enthält kein D3DMetal. Lade auf der Seite von Apple „Evaluation environment for Windows games“, nicht „Game Porting Toolkit“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no contiene D3DMetal. En la página de Apple descarga «Evaluation environment for Windows games», no «Game Porting Toolkit»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne contient pas D3DMetal. Sur la page d’Apple, téléchargez « Evaluation environment for Windows games », pas « Game Porting Toolkit »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non contiene D3DMetal. Dalla pagina di Apple scarica «Evaluation environment for Windows games», non «Game Porting Toolkit»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルには D3DMetal が含まれていません。Apple のページから「Game Porting Toolkit」ではなく「Evaluation environment for Windows games」をダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일에는 D3DMetal이 없습니다. Apple 페이지에서 'Game Porting Toolkit'이 아니라 'Evaluation environment for Windows games'를 다운로드하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом файле нет D3DMetal. Скачайте на странице Apple «Evaluation environment for Windows games», а не «Game Porting Toolkit»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件不包含 D3DMetal。请在 Apple 页面下载“Evaluation environment for Windows games”，而不是“Game Porting Toolkit”。"
          }
        }
      }
    },
    "This file isn't signed by Apple. It may be damaged: download it again from Apple's page.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist nicht von Apple signiert. Sie ist vielleicht beschädigt: Lade sie erneut von der Seite von Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no está firmado por Apple. Puede que esté dañado: vuelve a descargarlo de la página de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’est pas signé par Apple. Il est peut-être endommagé : téléchargez-le à nouveau depuis la page d’Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non è firmato da Apple. Potrebbe essere danneggiato: scaricalo di nuovo dalla pagina di Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルには Apple の署名がありません。破損している可能性があります。Apple のページからもう一度ダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 Apple 서명이 없습니다. 손상되었을 수 있으니 Apple 페이지에서 다시 다운로드하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл не подписан Apple. Возможно, он повреждён: скачайте его заново со страницы Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件没有 Apple 签名，可能已损坏：请从 Apple 页面重新下载。"
          }
        }
      }
    },
