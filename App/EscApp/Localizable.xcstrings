      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хорошо"
          }
        }
      }
    },
    "Preparing…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовимся…"
          }
        }
      }
    },
    "Update": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновить"
          }
        }
      }
    },
