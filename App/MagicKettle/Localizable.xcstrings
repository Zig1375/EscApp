    "The game checks for its CD on every launch": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel prüft bei jedem Start, ob seine CD eingelegt ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego comprueba su CD en cada arranque"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu vérifie la présence de son CD à chaque lancement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gioco controlla il suo CD a ogni avvio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームが起動のたびにCDを確認する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임이 실행할 때마다 CD를 확인합니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игра проверяет CD при каждом запуске"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏每次启动都会检查 CD"
          }
        }
      }
    },
    "The game goes into an ordinary folder on your Mac and stays there if its Windows is reset": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel kommt in einen normalen Ordner auf deinem Mac und bleibt dort, auch wenn sein Windows zurückgesetzt wird"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego va a una carpeta normal de tu Mac y se queda ahí aunque se restablezca su Windows"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu est placé dans un dossier ordinaire de votre Mac et y reste si son Windows est réinitialisé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gioco va in una normale cartella del Mac e ci resta anche se il suo Windows viene ripristinato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームはMac上の通常のフォルダに入り、Windows環境をリセットしてもそのまま残ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임은 Mac의 일반 폴더에 설치되며, 게임의 Windows를 재설정해도 그대로 남습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игра ставится в обычную папку на Mac и не пропадёт при сбросе среды"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏会放在 Mac 上的普通文件夹中，即使重置它的 Windows 也会保留"
          }
        }
      }
    },
    "The game starts with %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel startet mit %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego se inicia con %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu se lance avec %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gioco si avvia con %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームは%@で起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
