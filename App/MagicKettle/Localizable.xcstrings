    "Wine is still starting. The first launch can take up to a minute.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine startet noch. Der erste Start kann bis zu einer Minute dauern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine todavía se está iniciando. El primer arranque puede tardar hasta un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine est encore en cours de démarrage. Le premier lancement peut prendre jusqu’à une minute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine si sta ancora avviando. Il primo avvio può richiedere fino a un minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wineを起動中です。初回起動には最大1分かかることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine이 아직 시작 중입니다. 첫 실행은 최대 1분 정도 걸릴 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
