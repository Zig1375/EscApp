    "The game folder%@ goes to the Trash. Until the Trash is emptied, the game can be restored.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spielordner%@ wird in den Papierkorb gelegt. Solange der Papierkorb nicht entleert ist, kann das Spiel wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta del juego%@ va a la papelera. Hasta que se vacíe la papelera, el juego se puede recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier du jeu%@ est placé dans la corbeille. Tant que la corbeille n’est pas vidée, le jeu peut être restauré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella del gioco%@ va nel Cestino. Finché il Cestino non viene svuotato, il gioco può essere ripristinato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームフォルダ%@はゴミ箱に入ります。ゴミ箱を空にするまでは、ゲームを元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 폴더%@를 휴지통으로 옮깁니다. 휴지통을 비우기 전까지는 게임을 복원할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка игры%@ уйдёт в Корзину. Пока Корзина не очищена, игру можно восстановить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏文件夹%@将移到废纸篓。在清倒废纸篓之前，游戏都可以恢复。"
          }
        }
      }
    },
    "The game hasn't been started yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel wurde noch nicht gestartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego aún no se ha iniciado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu n’a pas encore été lancé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gioco non è ancora stato avviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲームはまだ起動していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임을 아직 실행하지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игру ещё не запускали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏尚未启动过。"
          }
        }
      }
    },
    "The game stays in %@. Magic Kettle forgets it and deletes its Windows setup. Double-click the exe to bring it back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel bleibt in %@. Magic Kettle vergisst es und löscht seine Windows-Umgebung. Doppelklicke auf die .exe, um es zurückzuholen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego se queda en %@. Magic Kettle lo olvida y elimina su configuración de Windows. Haz doble clic en el exe para recuperarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu reste dans %@. Magic Kettle l’oublie et supprime son installation Windows. Double-cliquez sur l’exe pour le récupérer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gioco resta in %@. Magic Kettle lo dimentica ed elimina il suo ambiente Windows. Fai doppio clic sul file exe per riaverlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームは%@に残ります。Magic Kettleはこのゲームを登録から外し、ゲーム用のWindows環境を削除します。exeをダブルクリックすると元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임은 %@에 그대로 남습니다. Magic Kettle은 게임을 목록에서 지우고 게임의 Windows 환경을 삭제합니다. exe를 이중 클릭하면 다시 추가됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игра останется в %@. Magic Kettle забудет её и удалит её среду Windows. Вернуть можно двойным щелчком по exe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏仍保留在 %@ 中。Magic Kettle 会忘记它并删除它的 Windows 环境。连按 exe 即可重新添加。"
          }
        }
      }
    },
    "This game is no longer in Magic Kettle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Spiel ist nicht mehr in Magic Kettle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este juego ya no está en Magic Kettle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jeu n’est plus dans Magic Kettle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo gioco non è più in Magic Kettle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲームはMagic Kettleにはもうありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임은 더 이상 Magic Kettle에 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этой игры больше нет в Magic Kettle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此游戏已不在 Magic Kettle 中。"
          }
        }
      }
    },
    "To add a game, double-click its .exe or .msi in Finder, or drag the file or its disc image onto the Magic Kettle icon in the Dock.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelklicke im Finder auf die .exe oder .msi eines Spiels oder zieh die Datei bzw. ihr Disk-Image auf das Magic-Kettle-Symbol im Dock, um es hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para añadir un juego, haz doble clic en su .exe o .msi en el Finder, o arrastra el archivo o su imagen de disco al icono de Magic Kettle en el Dock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ajouter un jeu, double-cliquez sur son .exe ou .msi dans le Finder, ou faites glisser le fichier ou son image disque sur l’icône de Magic Kettle dans le Dock."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungere un gioco, fai doppio clic sul suo file .exe o .msi nel Finder, oppure trascina il file o la sua immagine disco sull'icona di Magic Kettle nel Dock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームを追加するには、Finderでその.exeか.msiをダブルクリックするか、ファイルまたはディスクイメージをDockのMagic Kettleアイコンにドラッグします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임을 추가하려면 Finder에서 .exe 또는 .msi 파일을 이중 클릭하거나, 파일 또는 디스크 이미지를 Dock의 Magic Kettle 아이콘으로 드래그하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы добавить игру, дважды щёлкните по .exe или .msi в Finder или перетащите файл или образ диска на значок Magic Kettle в Dock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要添加游戏，请在访达中连按它的 .exe 或 .msi，或者将文件或其光盘映像拖到程序坞中的 Magic Kettle 图标上。"
          }
        }
      }
    },
