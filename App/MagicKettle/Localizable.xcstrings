            "value": "Les fichiers de %@ sont introuvables"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mancano i file di %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のファイルが見つかりません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
