    "%@ is out. It replaces the current version; games keep their saves and settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist erschienen. Es ersetzt die aktuelle Version; Spiele behalten ihre Spielstände und Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está disponible %@. Sustituye a la versión actual; los juegos conservan sus partidas guardadas y ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est disponible. Elle remplace la version actuelle ; les jeux conservent leurs sauvegardes et réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È disponibile %@. Sostituisce la versione attuale; i giochi mantengono salvataggi e impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が公開されました。現在のバージョンと置き換わります。ゲームのセーブデータと設定は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 출시되었습니다. 현재 버전을 대체하며, 게임의 저장 파일과 설정은 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вышел %@. Он заменит текущую версию, сохранения и настройки игр останутся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已推出。它会替换当前版本；游戏会保留其存档和设置。"
          }
        }
      }
    },
