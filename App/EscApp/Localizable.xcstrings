    "The game folder%@ goes to the Trash. Until the Trash is emptied, the game can be restored.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка игры%@ уйдёт в Корзину. Пока Корзина не очищена, игру можно восстановить."
          }
        }
      }
    },
    "The game hasn't been started yet.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игру ещё не запускали."
          }
        }
      }
    },
    "The game stays in %@. EscApp forgets it and deletes its Windows setup. Double-click the exe to bring it back.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игра останется в %@. EscApp забудет её и удалит её среду Windows. Вернуть можно двойным щелчком по exe."
