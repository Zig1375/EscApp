    "In any folder or on any disk: Downloads, an external drive, a disc image.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einem beliebigen Ordner oder auf einem beliebigen Laufwerk: Downloads, eine externe Festplatte, ein Disk-Image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cualquier carpeta o disco: Descargas, un disco externo, una imagen de disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans n’importe quel dossier ou disque : Téléchargements, un disque externe, une image disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In qualsiasi cartella o disco: Download, un disco esterno, un'immagine disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのフォルダやディスクでも構いません：ダウンロード、外部ドライブ、ディスクイメージなど。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 폴더나 디스크에 있어도 됩니다: 다운로드, 외장 드라이브, 디스크 이미지."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В любой папке или на любом диске: Загрузки, внешний диск, образ диска."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在任意文件夹或磁盘中：“下载”、外置驱动器或光盘映像。"
          }
        }
      }
    },
    "Double-click its .exe": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelklicke auf seine .exe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic en su .exe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-cliquez sur son .exe"
