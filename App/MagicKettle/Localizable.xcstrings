    "%@ and the games installed through it are removed from this Mac:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ und die darüber installierten Spiele werden von diesem Mac entfernt:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y los juegos instalados con ella se eliminan de este Mac:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ et les jeux installés par son intermédiaire seront supprimés de ce Mac :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ e i giochi installati tramite esso vengono rimossi da questo Mac:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@と、それを通じてインストールしたゲームがこのMacから削除されます："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 및 이를 통해 설치된 게임이 이 Mac에서 제거됩니다:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ и установленные через него игры будут удалены с этого Mac:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 以及通过它安装的游戏将从这台 Mac 上移除："
          }
        }
      }
    },
    "%@ is removed from this Mac. No games were installed through it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird von diesem Mac entfernt. Darüber wurden keine Spiele installiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se elimina de este Mac. No se instaló ningún juego con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sera supprimé de ce Mac. Aucun jeu n’a été installé par son intermédiaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ viene rimosso da questo Mac. Nessun gioco è stato installato tramite esso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がこのMacから削除されます。これを通じてインストールしたゲームはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 이 Mac에서 제거됩니다. 이를 통해 설치된 게임은 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ будет удалён с этого Mac. Игр через него не установлено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已从这台 Mac 上移除。没有通过它安装的游戏。"
          }
        }
      }
    },
    "%@ is running; Magic Kettle closes it first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft; Magic Kettle beendet es zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está abierta; Magic Kettle la cerrará primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est ouvert ; Magic Kettle le fermera d’abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è in esecuzione; Magic Kettle lo chiude prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が実行中です。Magic Kettleが先に終了させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 실행 중입니다. Magic Kettle이 먼저 종료합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ сейчас запущен, Magic Kettle сначала закроет его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在运行；Magic Kettle 会先将其关闭。"
          }
        }
      }
    },
