    },
    "The game folder%@ goes to the Trash. Until the Trash is emptied, the game can be restored.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка игры%@ уйдёт в Корзину. Пока Корзина не очищена, игру можно восстановить."
          }
        }
      }
    },
    "The game hasn't been started yet.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игру ещё не запускали."
          }
        }
      }
    },
    "The game stays in %@. EscApp forgets it and deletes its Windows setup. Double-click the exe to bring it back.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игра останется в %@. EscApp забудет её и удалит её среду Windows. Вернуть можно двойным щелчком по exe."
          }
        }
      }
    },
    "This game is no longer in EscApp.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этой игры больше нет в EscApp."
          }
        }
      }
    },
    "To add a game, double-click its .exe or .msi in Finder, or drag the file or its disc image onto the EscApp icon in the Dock.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы добавить игру, дважды щёлкните по .exe или .msi в Finder или перетащите файл или образ диска на значок EscApp в Dock."
          }
        }
      }
    },
    "under a minute": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "меньше минуты"
          }
        }
      }
    },
    "%lld launches": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld launch"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld launches"
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
