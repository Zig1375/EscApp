    "Stop": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановить"
          }
        }
      }
    },
    "Start playing": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играйте"
          }
        }
      }
    },
    "%@ (default)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (по умолчанию)"
          }
        }
      }
    },
    "%@ is out. It installs next to the current version; games keep their saves and settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вышел %@. Он встанет рядом с текущей версией, сохранения и настройки игр останутся."
          }
        }
      }
    },
    "%@ · %@ in total · from disk": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · всего %@ · с диска"
          }
        }
      }
    },
    "%@ · closed after %lld s (code %d)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · закрылась через %lld с (код %d)"
