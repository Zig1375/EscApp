    "The file is called .exe, but there's no Windows program inside. It may be damaged or not fully downloaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei heißt .exe, enthält aber kein Windows-Programm. Sie ist eventuell beschädigt oder nicht vollständig geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se llama .exe, pero no contiene ningún programa de Windows. Puede que esté dañado o que no se haya descargado del todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier porte l’extension .exe, mais il ne contient pas de programme Windows. Il est peut-être endommagé ou incomplètement téléchargé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file si chiama .exe, ma non contiene un programma Windows. Potrebbe essere danneggiato o scaricato in modo incompleto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル名は.exeですが、中にWindowsプログラムが入っていません。破損しているか、ダウンロードが完了していない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 이름은 .exe이지만 안에 Windows 프로그램이 없습니다. 파일이 손상되었거나 다운로드가 완료되지 않았을 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл называется .exe, но внутри не программа Windows. Возможно, он повреждён или скачан не до конца."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件名为 .exe，但里面没有 Windows 程序。它可能已损坏或未完整下载。"
          }
        }
      }
    },
    "The game asks for its disc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel verlangt seine Disc"
          }
        },
        "es": {
