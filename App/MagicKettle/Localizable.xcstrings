    "Auto now picks %@: it worked for this game last time. %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch wählt jetzt %@: Damit hat dieses Spiel beim letzten Mal funktioniert. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático elige ahora %@: le funcionó a este juego la última vez. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto choisit actuellement %@ : il a fonctionné pour ce jeu la dernière fois. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto ora sceglie %@: l'ultima volta ha funzionato con questo gioco. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動では%1$@を選択中：前回このゲームで動作しました。%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 자동은 %@을(를) 선택합니다: 지난번에 이 게임에서 작동했습니다. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Авто сейчас выбирает %1$@: с ним игра уже работала. %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动目前选择 %@：上次此游戏使用它运行正常。%@"
          }
        }
      }
    },
