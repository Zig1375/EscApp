    "⌘ works as Ctrl": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ работает как Ctrl"
          }
        }
      }
    },
    "Auto now picks %@: it worked for this game last time. %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Авто сейчас выбирает %1$@: с ним игра уже работала. %2$@"
