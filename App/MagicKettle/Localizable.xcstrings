    ".NET for games and installers that need it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ".NET für Spiele und Installationsprogramme, die es brauchen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ".NET para los juegos e instaladores que lo necesitan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ".NET pour les jeux et installeurs qui en ont besoin"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ".NET per i giochi e i programmi di installazione che lo richiedono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".NETを必要とするゲームやインストーラ用"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ".NET이 필요한 게임 및 설치 프로그램용 .NET"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ".NET для игр и установщиков, которым он нужен"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为需要它的游戏和安装器提供 .NET"
          }
        }
      }
    },
    "Graphics for DirectX 10 and 11 games": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
