      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить из EscApp"
          }
        }
      }
    },
    "EscApp can't open this file": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "EscApp не может открыть этот файл"
          }
        }
      }
    },
    "EscApp can't run .msi installers yet. Installing games arrives in a later version.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "EscApp пока не умеет запускать установщики .msi. Установка игр появится в одной из следующих версий."
          }
        }
      }
    },
    "Show Last Log": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать последний лог"
